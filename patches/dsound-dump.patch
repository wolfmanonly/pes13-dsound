--- a/dlls/dsound/buffer.c
+++ b/dlls/dsound/buffer.c
@@ -35,6 +35,54 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dsound);
 
+static void dsound_dump_best(IDirectSoundBufferImpl *dsb)
+{
+    static LONG best_peak;
+    const short *pcm;
+    int samples, i, peak = 0;
+    char info[192];
+    int len;
+    HANDLE h;
+    DWORD written;
+
+    if (!dsb->buffer || !dsb->buffer->memory || dsb->pwfx->wBitsPerSample != 16 ||
+        dsb->pwfx->nChannels != 6)
+        return;
+
+    samples = dsb->buflen / 2;
+    pcm = (const short *)dsb->buffer->memory;
+    for (i = 0; i < samples; i++) {
+        int v = pcm[i];
+        if (v < 0)
+            v = -v;
+        if (v > peak)
+            peak = v;
+    }
+    if (peak <= best_peak)
+        return;
+    best_peak = peak;
+
+    h = CreateFileA("C:\\dsound-dump.raw", GENERIC_WRITE, 0, NULL,
+                    CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        WriteFile(h, dsb->buffer->memory, dsb->buflen, &written, NULL);
+        CloseHandle(h);
+    }
+
+    len = wsprintfA(info,
+                    "peak=%d devch=%u bufch=%u buflen=%lu vol=%ld pan=%ld flags=0x%08lx\r\n",
+                    peak, dsb->device->pwfx->nChannels, dsb->pwfx->nChannels,
+                    dsb->buflen, dsb->volpan.lVolume, dsb->volpan.lPan,
+                    dsb->dsbd.dwFlags);
+    h = CreateFileA("C:\\dsound-dump.txt", GENERIC_WRITE, 0, NULL,
+                    CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        WriteFile(h, info, len, &written, NULL);
+        CloseHandle(h);
+    }
+}
+
+
 /*******************************************************************************
  *		IDirectSoundNotify
  */
@@ -312,6 +360,8 @@
 	int i;
 
 	TRACE("(%p,%08lx,%08lx,%08lx)\n",This,reserved1,reserved2,flags);
+
+	dsound_dump_best(This);
 
 	AcquireSRWLockExclusive(&This->lock);
 
