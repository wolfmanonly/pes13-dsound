+DWORD dsound_capture_until;
+LONG dsound_capture_token;
+
+static HANDLE capture_file;
+static LONG capture_token;
+static DWORD capture_bytes;
+static DWORD capture_limit;
+
+static void capture_mix(DirectSoundDevice *device, const void *buffer, DWORD bytes)
+{
+    DWORD now = GetTickCount();
+    DWORD written;
+    char info[160];
+    int len;
+
+    if (!dsound_capture_until || now >= dsound_capture_until)
+        return;
+
+    if (dsound_capture_token != capture_token) {
+        if (capture_file && capture_file != INVALID_HANDLE_VALUE)
+            CloseHandle(capture_file);
+        capture_file = CreateFileA("C:\\dsound-mix.raw", GENERIC_WRITE, 0, NULL,
+                                   CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        capture_token = dsound_capture_token;
+        capture_bytes = 0;
+        capture_limit = device->pwfx->nSamplesPerSec * device->pwfx->nBlockAlign * 2;
+
+        len = snprintf(info, sizeof(info),
+                       "rate=%lu ch=%u bits=%u tag=0x%04x block=%u\r\n",
+                       device->pwfx->nSamplesPerSec, device->pwfx->nChannels,
+                       device->pwfx->wBitsPerSample, device->pwfx->wFormatTag,
+                       device->pwfx->nBlockAlign);
+        {
+            HANDLE h = CreateFileA("C:\\dsound-mix.txt", GENERIC_WRITE, 0, NULL,
+                                   CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+            if (h != INVALID_HANDLE_VALUE) {
+                WriteFile(h, info, len, &written, NULL);
+                CloseHandle(h);
+            }
+        }
+    }
+
+    if (!capture_file || capture_file == INVALID_HANDLE_VALUE)
+        return;
+    if (capture_bytes >= capture_limit)
+        return;
+    if (bytes > capture_limit - capture_bytes)
+        bytes = capture_limit - capture_bytes;
+    WriteFile(capture_file, buffer, bytes, &written, NULL);
+    capture_bytes += written;
+}
