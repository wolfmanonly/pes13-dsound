@@ -31,6 +31,40 @@
 #include "uuids.h"
 
 #include "wine/list.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+
+/* TEMPORARY DIAGNOSTIC: append one line to C:\\dsound-probe.log. */
+static inline void dsound_probe(const char *fmt, ...)
+{
+    static int probe_budget = 30000;
+    char buf[512];
+    va_list ap;
+    int n, prefix;
+    HANDLE h;
+    DWORD written;
+
+    if (probe_budget <= 0) return;
+    prefix = snprintf(buf, sizeof(buf) - 2, "[%8lu] ", GetTickCount());
+    if (prefix < 0) return;
+    if (prefix > (int)sizeof(buf) - 2) prefix = sizeof(buf) - 2;
+    va_start(ap, fmt);
+    n = vsnprintf(buf + prefix, sizeof(buf) - 2 - prefix, fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    n += prefix;
+    if (n > (int)sizeof(buf) - 2) n = sizeof(buf) - 2;
+    buf[n++] = '\r';
+    buf[n++] = '\n';
+    probe_budget--;
+    h = CreateFileW(L"C:\\dsound-probe.log", FILE_APPEND_DATA,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS,
+                    FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return;
+    WriteFile(h, buf, n, &written, NULL);
+    CloseHandle(h);
+}
 
