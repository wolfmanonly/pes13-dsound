--- a/dlls/dsound/primary.c
+++ b/dlls/dsound/primary.c
@@ -242,6 +242,18 @@
     if (!w)
         return DSERR_OUTOFMEMORY;
 
+    if (w->nChannels > 2) {
+        /* The Switch audout backend is stereo.  Clamp the device format so
+         * dsound downmixes 5.1/7.1 secondary buffers to 2.0 instead of
+         * feeding centre/LFE channels to a stereo backend. */
+        w->nChannels = 2;
+        w->nBlockAlign = w->nChannels * w->wBitsPerSample / 8;
+        w->nAvgBytesPerSec = w->nSamplesPerSec * w->nBlockAlign;
+        if (w->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+            ((WAVEFORMATEXTENSIBLE *)w)->dwChannelMask =
+                SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT;
+    }
+
     *wfx = w;
     return S_OK;
 }
