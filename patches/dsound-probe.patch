--- a/dlls/dsound/dsound_private.h
+++ b/dlls/dsound/dsound_private.h
@@ -31,6 +31,36 @@
 #include "uuids.h"
 
 #include "wine/list.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+
+/* TEMPORARY DIAGNOSTIC: append one line to C:\\dsound-probe.log. */
+static inline void dsound_probe(const char *fmt, ...)
+{
+    static int probe_budget = 4000;
+    char buf[400];
+    va_list ap;
+    int n;
+    HANDLE h;
+    DWORD written;
+
+    if (probe_budget <= 0) return;
+    va_start(ap, fmt);
+    n = vsnprintf(buf, sizeof(buf) - 2, fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 2) n = sizeof(buf) - 2;
+    buf[n++] = '\r';
+    buf[n++] = '\n';
+    probe_budget--;
+    h = CreateFileW(L"C:\\dsound-probe.log", FILE_APPEND_DATA,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS,
+                    FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return;
+    WriteFile(h, buf, n, &written, NULL);
+    CloseHandle(h);
+}
 
