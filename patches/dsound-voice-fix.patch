--- a/dlls/dsound/buffer.c
+++ b/dlls/dsound/buffer.c
@@ -400,6 +400,17 @@
 	AcquireSRWLockExclusive(&This->lock);
 
 	This->playflags = flags;
+	/* PES13/CRI ADX reuses two short 6ch buffers as one-shots and never
+	 * calls Stop(). Play() on an already-running buffer only overwrites
+	 * playflags, leaving sec_mixpos past buflen -> get_samples() returns
+	 * silence. Treat every Play() as a fresh start for those buffers. */
+	if (This->pwfx && This->pwfx->nChannels == 6 && This->buflen <= 65536) {
+		This->playflags &= ~DSBPLAY_LOOPING;
+		This->sec_mixpos = 0;
+		This->use_committed = FALSE;
+		This->committed_mixpos = 0;
+		This->state = STATE_STOPPED;
+	}
 	if (This->state == STATE_STOPPED) {
 		This->state = STATE_STARTING;
 	}
